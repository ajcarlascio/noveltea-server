# Copy to .env and edit. Compose reads .env from this directory automatically.
#
# Two values below have no default and the stack refuses to start without them. That is
# deliberate: both are the kind of thing that, given a fallback, ships with the fallback.

# --- required ---------------------------------------------------------------

# openssl rand -base64 48
NOVELTEA_JWT_SECRET=

# Anything long. Nothing outside the compose network connects to Postgres, but this ends
# up in the worker's connection string too, so it is not decorative.
POSTGRES_PASSWORD=

# --- the first account ------------------------------------------------------

# Left as they are, you sign in with admin@localhost / admin and the server immediately
# makes you choose a real password before it will do anything else. Set a real password
# here (twelve characters or more) and there is nothing to change.
NOVELTEA_ADMIN_EMAIL=admin@localhost
NOVELTEA_ADMIN_PASSWORD=

# false: accounts come from the administrator, not from whoever can reach the address.
NOVELTEA_OPEN_REGISTRATION=false

# --- the rest ---------------------------------------------------------------

# Where the browser client is published on the host.
NOVELTEA_PORT=8080

# Pin to a release instead of tracking latest once the instance is one you rely on.
NOVELTEA_VERSION=latest

POSTGRES_DB=noveltea
POSTGRES_USER=noveltea

# Unset means password-reset links are written to the API's log instead of sent. Workable
# for a single operator; a second user cannot read your logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOVELTEA_MAIL_FROM=noveltea@localhost

# The address people actually type, used to build the links in those emails.
NOVELTEA_APP_URL=

# The full route and schema map. Off unless you want it published.
NOVELTEA_API_DOCS_ENABLED=false
