# Gradle / JVM
.gradle/
build/
*.class
*.jar
# ...but the Gradle wrapper jar must be committed, or ./gradlew cannot bootstrap.
!gradle/wrapper/gradle-wrapper.jar
*.war
out/

# Node / worker
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*
.npm/

# Local config & secrets
.env
.env.*
!.env.example
*.local
application-local.yml
*.pem
*.key

# Export / compile scratch output
/tmp-compile/
*.epub
*.docx
*.odt
*.rtf
*.pdf

# Editors / OS
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# Local Gradle distribution — belongs outside the repo, not in it
/gradle-*-bin.zip
/gradle-[0-9]*/

# Generated migration bundle — rebuilt by `npm run generate`
packages/*/src/generated/

# Private commercial roadmap — never commit
PAID-FEATURES.local.md
*.private.md

# Coding-agent instructions — local only, deliberately.
#
# CLAUDE.md, AGENTS.md and .claude/ are how *this machine* drives an agent over the
# repository. They are not product documentation: the architecture and the invariants
# moved to docs/architecture.md, which is where a human or an external auditor looks.
#
# Untracked with `git rm --cached`, so the files survive on disk and only leave the
# remote. They remain in the repository's *history*; this stops them going forward.
CLAUDE.md
AGENTS.md
GEMINI.md
.claude/
.cursor/
.cursorrules
.aider*
.github/copilot-instructions.md
