# Gradle / JVM
.gradle/
build/
*.class
*.jar
# ...but the Gradle wrapper jar must be committed, or ./gradlew cannot bootstrap.
!gradle/wrapper/gradle-wrapper.jar
*.war
out/

# Node / worker
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*
.npm/

# Local config & secrets
.env
.env.*
!.env.example
*.local
application-local.yml
*.pem
*.key

# Export / compile scratch output
/tmp-compile/
*.epub
*.docx
*.odt
*.rtf
*.pdf

# Editors / OS
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# Local Gradle distribution — belongs outside the repo, not in it
/gradle-*-bin.zip
/gradle-[0-9]*/

# Generated migration bundle — rebuilt by `npm run generate`
packages/*/src/generated/
